{
    "schema_version": "v0.4",
    "name": "tag_vocab",
    "description": "에피소드 메타데이터 태그 어휘 정본. 설계 근거는 pipeline_design_guide_v0.4.md",
    "episode_unit": "1 record = 1 ego 거동 사건 = (ego 거동, 원인 집합) 쌍. 종·횡 병합, 원인은 순위 없는 다중 집합, 직접 원인만 기록",
    "episode_structure": {
      "segment": [
        "anchor",
        "window",
        "ego_action",
        "environment",
        "causal_links",
        "flags",
        "versioning",
        "episode_confidence"
      ],
      "subjects": "원인 후보별 배열. 각 항목 = candidate_id + cause_type + 유형별 서술 블록 + measurements + visual_attributes + candidate_assessment",
      "note": "environment는 맥락 필드이며 cause_type이 아님 (이중 계상 방지)",
      "see_also": {
        "window": "시간 경계 정의는 최상위 window 블록",
        "anchor": "key_frame_t 산출 규칙은 anchor 블록",
        "ego_action": "거동 라벨 해소 정책은 ego_action.anchor_policy"
      }
    },
    "anchor": {
      "key_frame_t": {
        "type": "timestamp",
        "source": "CAN rule",
        "note": "모델 비관여. 규칙 산출 전용"
      },
      "transition_threshold_set_id": {
        "type": "string",
        "note": "임계 변경 = 데이터셋 변경. 반드시 각인"
      },
      "see_also": "거동 유형별 산출 정책은 ego_action.anchor_policy"
    },
    "window": {
      "role": "에피소드 시간 경계 정의 — 본 블록이 유일 정본. key_frame_t는 anchor 블록에서 정의되며 여기서는 경계 기준점으로만 사용",
      "window_start": {
        "type": "timestamp",
        "semantics": "사건 기준 역방향 확장 — 직전 자차 전이 또는 원인 후보 상태변화 중 먼저 만나는 지점"
      },
      "window_end": {
        "type": "timestamp",
        "semantics": "자차 거동 완료·안정 상태 진입 시점. key_frame_t에서 끊지 않음 (ego-path·결과 상태 보존)"
      },
      "window_start_reason": {
        "type": "enum",
        "values": [
          "prev_ego_transition",
          "candidate_state_change",
          "budget_truncation"
        ]
      },
      "window_end_reason": {
        "type": "enum",
        "values": [
          "maneuver_complete",
          "next_transition",
          "clip_end",
          "budget_truncation"
        ]
      },
      "window_truncated": {
        "type": "bool",
        "note": "true여도 정상 에피소드로 편입. 절단률은 원인 유형·거동 유형별 집계 보고"
      },
      "judgment_scope": "모든 필드 판정에 창 전 구간 사용 (시점 제한 없음). 사후 정보 사용 사실은 export_contract에 표기",
      "causal_judgment_scope": {
        "type": "enum",
        "values": ["full_window", "pre_anchor"],
        "default": "full_window",
        "note": "judgment_scope 정책(서술문)의 레코드별 기록형. full_window=창 전체 사용(사후정보 포함, 기본) / pre_anchor=key_frame_t 이전만(순환성·EPR 대조실험용, §3.6 이중 pass calibration과 연동 가능). 제안 필드 — v0.4 최초 도입, guide 원문에 필드명 없음"
      }
    },
    "ego_action": {
      "form": "transition + resulting_state 병기. 종·횡 병합 단일 사건",
      "longitudinal": {
        "transition": {
          "type": "enum",
          "values": [
            "decel_onset",
            "accel_onset",
            "stop_initiate",
            "launch",
            "reverse_onset",
            "none"
          ]
        },
        "resulting_state": {
          "type": "enum",
          "values": [
            "standstill",
            "cruise",
            "creep",
            "decelerating",
            "accelerating",
            "reversing"
          ]
        }
      },
      "lateral": {
        "transition": {
          "type": "enum",
          "values": [
            "lane_change_left_onset",
            "lane_change_right_onset",
            "in_lane_shift_left",
            "in_lane_shift_right",
            "turn_left_onset",
            "turn_right_onset",
            "none"
          ]
        },
        "resulting_state": {
          "type": "enum",
          "values": [
            "lane_keep",
            "changing_left",
            "changing_right",
            "turning_left",
            "turning_right",
            "offset_left",
            "offset_right"
          ]
        }
      },
      "consistency_check": "transition과 resulting_state의 조합 정합성은 자동 검증 항목. 결정론적 귀결이 아닌 조합(decel_onset→cruise)은 유효",
      "anchor_policy": {
        "transition_time": "CAN 규칙 확정 — 모델 비관여",
        "longitudinal": "CAN 규칙 확정",
        "lateral_type": "CAN은 전이 트리거만. 좌/우회전·차선변경·U턴 라벨은 지도 ∪ VLM으로 해소 — CAN 요레이트만으로 교차로 회전·도로 곡률·분기·U턴 구분 불가",
        "evaluation": "경로 유형 라벨은 규칙 확정값이 아니므로 평가 대상. AUTO_GT 사용 금지"
      }
    },
    "cause_type": {
      "values": [
        "agent",
        "static_object",
        "traffic_control",
        "road_geometry",
        "road_condition",
        "ego_intent"
      ],
      "note": "유형에 따라 필드 집합이 달라짐. environment는 cause_type이 아니라 맥락 필드",
      "field_sets": {
        "agent": [
          "object_type",
          "position_wrt_ego",
          "motion_primitive",
          "measurements",
          "visual_attributes"
        ],
        "static_object": [
          "static_object_type",
          "position_wrt_ego",
          "measurements",
          "visual_attributes"
        ],
        "traffic_control": [
          "control_element",
          "control_state",
          "applies_to",
          "position_wrt_ego"
        ],
        "road_geometry": [
          "geometry_type",
          "position_wrt_ego",
          "measurements"
        ],
        "road_condition": [
          "condition_type",
          "position_wrt_ego"
        ],
        "ego_intent": [
          "intent_type"
        ]
      }
    },
