            "sidewalk",
            "off_road",
            "unknown"
          ],
          "note": "map_valid=false 시 corridor 근사 폴백. fallback_path 플래그 필수"
        },
        "bearing": {
          "type": "enum",
          "map_dependent": false,
          "values": [
            "front",
            "front_left",
